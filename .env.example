# OpenAI：视频分析、语音转文字、脚本与 Sora 视频生成
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5.4
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_VIDEO_MODEL=sora-2

# TikTok Shop Partner Center：官方 Bestsellers 榜单
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_REFRESH_TOKEN=
TIKTOK_SHOP_CIPHER=

# 可选：AI 模特商品视频
CREATIFY_API_ID=
CREATIFY_API_KEY=

PORT=5173
HOST=127.0.0.1
DATA_DIR=data
# 云端部署使用，Render 会自动填写
DATABASE_URL=

# 云端生产环境必须填写。请使用长且不重复的随机值。
VIRALFLOW_ADMIN_PASSWORD=
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
REQUIRE_AUTH=false
