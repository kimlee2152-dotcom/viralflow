# Google Gemini：完整视频理解、脚本与 Gemini Omni Flash 视频生成
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_VIDEO_MODEL=gemini-omni-flash-preview

# TikTok Shop Partner Center：官方 Bestsellers 榜单
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_REFRESH_TOKEN=
TIKTOK_SHOP_CIPHER=

PORT=5173
HOST=127.0.0.1
DATA_DIR=data
# 云端部署使用，Render 会自动填写
DATABASE_URL=

# 云端生产环境必须填写。请使用长且不重复的随机值。
VIRALFLOW_ADMIN_PASSWORD=
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
REQUIRE_AUTH=false
