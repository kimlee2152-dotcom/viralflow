PORT=5173
HOST=127.0.0.1
DATA_DIR=data
# 云端部署使用，Render 会自动填写
DATABASE_URL=

# 云端生产环境必须填写。请使用长且不重复的随机值。
VIRALFLOW_ADMIN_PASSWORD=
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
REQUIRE_AUTH=false

# 平台额度：新客户赠送额度与各类真实任务的扣费点数
SIGNUP_CREDITS=10
CREDIT_COST_SCRIPT=1
CREDIT_COST_VIDEO_ANALYSIS=3
