# Google Gemini：完整视频理解、脚本与 Gemini Omni Flash 视频生成
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_VIDEO_MODEL=gemini-omni-flash-preview

# Runway：同时提供 Seedance 2（国内模型）与 Runway Gen-4.5（海外模型）
RUNWAYML_API_SECRET=
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
SEEDANCE_VIDEO_MODEL=seedance2
RUNWAY_VIDEO_MODEL=gen4.5

# TikTok Shop Partner Center：官方 Bestsellers 榜单
TIKTOK_SHOP_APP_KEY=
